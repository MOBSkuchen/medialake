<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="MediaLake.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:MediaLake"
    Title="SearchNow">
    <Grid x:Name="Root" Padding="24,18,24,14" RowSpacing="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="4" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid>
            <TextBlock Text="SearchNow" FontSize="30" FontWeight="Black" VerticalAlignment="Center" />
            <Button x:Name="SettingsButton" HorizontalAlignment="Right" VerticalAlignment="Center"
                    Click="Settings_Click" ToolTipService.ToolTip="Settings" Background="Transparent" BorderThickness="0">
                <FontIcon Glyph="&#xE713;" />
            </Button>
        </Grid>

        <TextBox x:Name="QueryBox" Grid.Row="1" PlaceholderText="Search files, images, audio…" FontSize="18"
                 TextChanged="Query_TextChanged" PreviewKeyDown="Query_PreviewKeyDown" />

        <!-- sliding "searching" indicator right below the input box -->
        <ProgressBar x:Name="LoadingBar" Grid.Row="2" IsIndeterminate="True" Visibility="Collapsed"
                     VerticalAlignment="Top" Margin="2,0" />

        <ListView x:Name="ResultsList" Grid.Row="3" IsItemClickEnabled="True" SelectionMode="Single"
                  ItemClick="Results_ItemClick" ItemsSource="{x:Bind Items}" Visibility="Collapsed">
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="local:ResultItem">
                    <Grid ColumnSpacing="12" Padding="2,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="44" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Grid Width="44" Height="44" CornerRadius="6">
                            <FontIcon Glyph="{x:Bind Glyph}" FontSize="22" Opacity="0.6" />
                            <Image Source="{x:Bind Thumb, Mode=OneWay}" Stretch="UniformToFill" />
                        </Grid>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="1">
                            <TextBlock Text="{x:Bind Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                            <TextBlock Text="{x:Bind Folder}" Opacity="0.6" FontSize="12" TextTrimming="CharacterEllipsis" />
                            <TextBlock Text="{x:Bind Snippet}" Opacity="0.75" FontSize="12" MaxLines="2"
                                       TextWrapping="Wrap" Visibility="{x:Bind SnippetVisibility}" />
                        </StackPanel>
                        <StackPanel Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right" Spacing="2">
                            <Border CornerRadius="4" Padding="7,1" HorizontalAlignment="Right" Background="{x:Bind BadgeBrush}">
                                <TextBlock Text="{x:Bind Modality}" FontSize="11" FontWeight="SemiBold" Foreground="White" />
                            </Border>
                            <TextBlock Text="{x:Bind ScoreText}" FontSize="11" Opacity="0.6" HorizontalAlignment="Right" />
                        </StackPanel>
                        <Button Grid.Column="3" VerticalAlignment="Center" Tag="{x:Bind Path}" Click="OpenInExplorer_Click"
                                ToolTipService.ToolTip="Open in Explorer (Ctrl+Enter)" Padding="8" Background="Transparent" BorderThickness="0">
                            <FontIcon Glyph="&#xE838;" FontSize="16" />
                        </Button>
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <TextBlock x:Name="EmptyText" Grid.Row="3" HorizontalAlignment="Center" VerticalAlignment="Center"
                   Opacity="0.55" TextAlignment="Center" TextWrapping="Wrap" Text="" />

        <!-- first run: the model is not on this computer yet -->
        <StackPanel x:Name="SetupPanel" Grid.Row="3" Spacing="12" Visibility="Collapsed" Padding="0,10,0,0">
            <TextBlock Text="One more step: download the search model" FontSize="18" FontWeight="SemiBold" />
            <TextBlock TextWrapping="Wrap" Opacity="0.75"
                       Text="MediaLake understands your files with an AI model that runs on this computer. It is downloaded once and stays here. Pick a quality (you can change it later in Settings):" />
            <ComboBox x:Name="SetupQuality" MinWidth="440" />
            <StackPanel Orientation="Horizontal" Spacing="12">
                <Button x:Name="SetupButton" Content="Download" Style="{StaticResource AccentButtonStyle}" Click="SetupDownload_Click" />
                <TextBlock x:Name="SetupInfo" VerticalAlignment="Center" Opacity="0.75" />
            </StackPanel>
            <ProgressBar x:Name="SetupBar" Minimum="0" Maximum="1" Visibility="Collapsed" />
        </StackPanel>

        <StackPanel Grid.Row="4" Spacing="4">
            <ProgressBar x:Name="IndexBar" Minimum="0" Maximum="1" Height="4" Visibility="Collapsed" />
            <TextBlock x:Name="StatusText" Opacity="0.65" FontSize="12" TextTrimming="CharacterEllipsis" />
        </StackPanel>
    </Grid>
</Window>
