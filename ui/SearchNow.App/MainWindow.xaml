<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="SearchNow.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:SearchNow"
    Title="SearchNow">
    <Grid x:Name="Root" Padding="24,18,24,14" RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid>
            <TextBlock Text="SearchNow" FontSize="30" FontWeight="Black" VerticalAlignment="Center" />
            <Button x:Name="SettingsButton" HorizontalAlignment="Right" VerticalAlignment="Center"
                    Click="Settings_Click" ToolTipService.ToolTip="Settings" Background="Transparent" BorderThickness="0">
                <FontIcon Glyph="&#xE713;" />
            </Button>
        </Grid>

        <TextBox x:Name="QueryBox" Grid.Row="1" PlaceholderText="Search files, images, audio…" FontSize="18"
                 TextChanged="Query_TextChanged" PreviewKeyDown="Query_PreviewKeyDown" />

        <ListView x:Name="ResultsList" Grid.Row="2" IsItemClickEnabled="True" SelectionMode="Single"
                  ItemClick="Results_ItemClick" ItemsSource="{x:Bind Items}" Visibility="Collapsed">
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="local:ResultItem">
                    <Grid ColumnSpacing="12" Padding="2,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="44" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Grid Width="44" Height="44" CornerRadius="6">
                            <FontIcon Glyph="{x:Bind Glyph}" FontSize="22" Opacity="0.6" />
                            <Image Source="{x:Bind Thumb, Mode=OneWay}" Stretch="UniformToFill" />
                        </Grid>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="1">
                            <TextBlock Text="{x:Bind Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                            <TextBlock Text="{x:Bind Folder}" Opacity="0.6" FontSize="12" TextTrimming="CharacterEllipsis" />
                            <TextBlock Text="{x:Bind Snippet}" Opacity="0.75" FontSize="12" MaxLines="2"
                                       TextWrapping="Wrap" Visibility="{x:Bind SnippetVisibility}" />
                        </StackPanel>
                        <StackPanel Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right" Spacing="2">
                            <Border CornerRadius="4" Padding="6,1" HorizontalAlignment="Right"
                                    Background="{ThemeResource ControlFillColorSecondaryBrush}">
                                <TextBlock Text="{x:Bind Modality}" FontSize="11" />
                            </Border>
                            <TextBlock Text="{x:Bind ScoreText}" FontSize="11" Opacity="0.6" HorizontalAlignment="Right" />
                        </StackPanel>
                        <Button Grid.Column="3" VerticalAlignment="Center" Tag="{x:Bind Path}" Click="OpenInExplorer_Click"
                                ToolTipService.ToolTip="Open in Explorer (Ctrl+Enter)" Padding="8" Background="Transparent" BorderThickness="0">
                            <FontIcon Glyph="&#xE838;" FontSize="16" />
                        </Button>
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <TextBlock x:Name="EmptyText" Grid.Row="2" HorizontalAlignment="Center" VerticalAlignment="Center"
                   Opacity="0.55" TextAlignment="Center" TextWrapping="Wrap" Text="" />

        <TextBlock x:Name="StatusText" Grid.Row="3" Opacity="0.65" FontSize="12" TextTrimming="CharacterEllipsis" />
    </Grid>
</Window>
