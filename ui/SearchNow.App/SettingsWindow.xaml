<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="SearchNow.SettingsWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="SearchNow Settings">
    <NavigationView x:Name="Nav" PaneDisplayMode="Left" IsBackButtonVisible="Collapsed" IsSettingsVisible="False"
                    OpenPaneLength="190" SelectionChanged="Nav_SelectionChanged">
        <NavigationView.MenuItems>
            <NavigationViewItem Content="General" Tag="general" IsSelected="True">
                <NavigationViewItem.Icon><FontIcon Glyph="&#xE713;" /></NavigationViewItem.Icon>
            </NavigationViewItem>
            <NavigationViewItem Content="Model" Tag="model">
                <NavigationViewItem.Icon><FontIcon Glyph="&#xE9D9;" /></NavigationViewItem.Icon>
            </NavigationViewItem>
            <NavigationViewItem Content="Index" Tag="index">
                <NavigationViewItem.Icon><FontIcon Glyph="&#xE8B7;" /></NavigationViewItem.Icon>
            </NavigationViewItem>
        </NavigationView.MenuItems>

        <Grid>
            <!-- ================= General ================= -->
            <ScrollViewer x:Name="PageGeneral">
                <StackPanel Padding="32,24" Spacing="20" MaxWidth="720" HorizontalAlignment="Left">
                    <TextBlock Text="General" Style="{StaticResource TitleTextBlockStyle}" />

                    <StackPanel Spacing="6">
                        <TextBlock Text="Global shortcut" FontWeight="SemiBold" />
                        <TextBlock Text="Press this shortcut anywhere to open the search window." Opacity="0.7" />
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <Border x:Name="HotkeyBox" BorderThickness="1" CornerRadius="4" Padding="14,8" MinWidth="220" IsTabStop="True"
                                    BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                                    Background="{ThemeResource ControlFillColorDefaultBrush}"
                                    KeyDown="HotkeyBox_KeyDown" GotFocus="HotkeyBox_GotFocus" LostFocus="HotkeyBox_LostFocus" Tapped="HotkeyBox_Tapped">
                                <TextBlock x:Name="HotkeyText" Text="Ctrl+Alt+Space" />
                            </Border>
                            <TextBlock x:Name="HotkeyHint" Text="Click, then press the new combination" VerticalAlignment="Center" Opacity="0.6" />
                        </StackPanel>
                        <TextBlock x:Name="HotkeyError" Foreground="{ThemeResource SystemFillColorCriticalBrush}" />
                    </StackPanel>

                    <ToggleSwitch x:Name="AutostartSwitch" Header="Start SearchNow when I sign in" Toggled="Autostart_Toggled" />
                </StackPanel>
            </ScrollViewer>

            <!-- ================= Model ================= -->
            <ScrollViewer x:Name="PageModel" Visibility="Collapsed">
                <StackPanel Padding="32,24" Spacing="20" MaxWidth="720" HorizontalAlignment="Left">
                    <TextBlock Text="Model" Style="{StaticResource TitleTextBlockStyle}" />

                    <RadioButtons x:Name="ModeRadios" Header="Where should embeddings be computed?" SelectionChanged="Mode_SelectionChanged">
                        <RadioButton Content="On this computer (bundled server)" Tag="local" />
                        <RadioButton Content="On a remote server" Tag="remote" />
                    </RadioButtons>

                    <StackPanel x:Name="LocalPanel" Spacing="14">
                        <ComboBox x:Name="ModelCombo" Header="Model" MinWidth="320">
                            <ComboBoxItem Content="EmbeddingGemma 2 (text, images, audio, video)" IsSelected="True" />
                        </ComboBox>
                        <StackPanel Spacing="6">
                            <ComboBox x:Name="QualityCombo" Header="Quality" MinWidth="320" SelectionChanged="Quality_SelectionChanged">
                                <ComboBoxItem Content="Heavy: most precise, largest" Tag="heavy" />
                                <ComboBoxItem Content="Normal: recommended" Tag="normal" />
                                <ComboBoxItem Content="Light: smallest and fastest" Tag="light" />
                            </ComboBox>
                            <TextBlock x:Name="QualityInfo" Opacity="0.7" TextWrapping="Wrap" />
                            <Button x:Name="DownloadNow" Content="Download now" Visibility="Collapsed" Click="DownloadNow_Click" Style="{StaticResource AccentButtonStyle}" />
                            <ProgressBar x:Name="DownloadBar" Visibility="Collapsed" Minimum="0" Maximum="1" />
                            <TextBlock x:Name="DownloadText" Opacity="0.7" Visibility="Collapsed" />
                            <Button x:Name="CancelDownload" Content="Cancel download" Visibility="Collapsed" Click="CancelDownload_Click" />
                        </StackPanel>
                    </StackPanel>

                    <StackPanel x:Name="RemotePanel" Spacing="10" Visibility="Collapsed">
                        <TextBox x:Name="PairCode" Header="Pairing code" PlaceholderText="SN1-…  (run &quot;searchnow-server pair&quot; on the server)" />
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <Button x:Name="ConnectButton" Content="Connect" Click="Connect_Click" Style="{StaticResource AccentButtonStyle}" />
                            <TextBlock x:Name="RemoteStatus" VerticalAlignment="Center" Opacity="0.8" TextWrapping="Wrap" />
                        </StackPanel>
                        <TextBlock x:Name="RemoteQuality" Opacity="0.7" />
                        <InfoBar IsOpen="True" IsClosable="False" Severity="Informational"
                                 Message="With a remote server, the content of your indexed files is sent to that server for embedding. The connection is encrypted and pinned to the server's certificate." />
                    </StackPanel>

                    <StackPanel Spacing="4">
                        <TextBlock Text="Confidence threshold" FontWeight="SemiBold" />
                        <TextBlock Text="Results below this confidence are hidden." Opacity="0.7" />
                        <Slider x:Name="ThresholdSlider" Minimum="0" Maximum="1" StepFrequency="0.01" Width="360" HorizontalAlignment="Left"
                                ValueChanged="Slider_ValueChanged" />
                    </StackPanel>

                    <Expander Header="Experimental" IsExpanded="False" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                        <StackPanel Spacing="8">
                            <ToggleSwitch x:Name="VideoSwitch" Header="Embed video content" Toggled="Video_Toggled" />
                            <TextBlock Opacity="0.7" TextWrapping="Wrap"
                                       Text="Samples up to 8 frames per video. Slow and CPU-heavy: turning this on queues all videos for content embedding; turning it off removes their content vectors. Videos are always searchable by name." />
                        </StackPanel>
                    </Expander>
                </StackPanel>
            </ScrollViewer>

            <!-- ================= Index ================= -->
            <ScrollViewer x:Name="PageIndex" Visibility="Collapsed">
                <StackPanel Padding="32,24" Spacing="20" MaxWidth="760" HorizontalAlignment="Left">
                    <TextBlock Text="Index" Style="{StaticResource TitleTextBlockStyle}" />

                    <StackPanel Spacing="8">
                        <TextBlock Text="Indexed folders" FontWeight="SemiBold" />
                        <ListView x:Name="DirList" SelectionMode="None" MinHeight="40" MaxHeight="240">
                            <ListView.ItemTemplate>
                                <DataTemplate x:DataType="local:DirItem" xmlns:local="using:SearchNow">
                                    <Grid ColumnSpacing="12" Padding="0,2">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{x:Bind Path}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                        <CheckBox Grid.Column="1" Content="Include subfolders" IsChecked="{x:Bind Recursive, Mode=TwoWay}"
                                                  Tag="{x:Bind Path}" Click="Recursive_Click" MinWidth="0" />
                                        <Button Grid.Column="2" Tag="{x:Bind Path}" Click="RemoveDir_Click" ToolTipService.ToolTip="Remove">
                                            <FontIcon Glyph="&#xE74D;" FontSize="14" />
                                        </Button>
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                        <Button x:Name="AddDirButton" Content="Add folder…" Click="AddDir_Click" />
                    </StackPanel>

                    <StackPanel Spacing="4">
                        <TextBlock Text="Wait after a file is modified" FontWeight="SemiBold" />
                        <TextBlock x:Name="DebounceLabel" Opacity="0.7" />
                        <Slider x:Name="DebounceSlider" Minimum="0.5" Maximum="60" StepFrequency="0.5" Width="360" HorizontalAlignment="Left"
                                ValueChanged="Slider_ValueChanged" />
                    </StackPanel>

                    <StackPanel Spacing="4">
                        <TextBlock Text="Minimum change to re-embed" FontWeight="SemiBold" />
                        <TextBlock x:Name="MinChangeLabel" Opacity="0.7" />
                        <Slider x:Name="MinChangeSlider" Minimum="0" Maximum="1" StepFrequency="0.01" Width="360" HorizontalAlignment="Left"
                                ValueChanged="Slider_ValueChanged" />
                    </StackPanel>

                    <StackPanel Spacing="4">
                        <TextBlock Text="Maximum file size to index" FontWeight="SemiBold" />
                        <TextBlock x:Name="MaxSizeLabel" Opacity="0.7" />
                        <Slider x:Name="MaxSizeSlider" Minimum="0" Maximum="1" StepFrequency="0.01" Width="360" HorizontalAlignment="Left"
                                ValueChanged="Slider_ValueChanged" />
                    </StackPanel>

                    <StackPanel Spacing="8">
                        <TextBlock x:Name="StatsText" Opacity="0.8" />
                        <Button Content="Reindex all" Click="Reindex_Click" />
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </NavigationView>
</Window>
